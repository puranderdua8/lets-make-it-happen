{
  "name": "lets-make-it-happen",
  "version": "1.0.0",
  "description": "Backend for a virtual event management platform: JWT auth, event CRUD, participant registration, email notifications.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/email.worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.9",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "nodemailer": "^9.0.3",
    "rate-limit-redis": "^6.0.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
