# Server
PORT=3000

# Number of clustered API processes (1 = no clustering)
WEB_CONCURRENCY=1

# Redis (optional). Leave unset to run in simple/single-instance mode: no
# read cache (reads hit MongoDB directly), in-process rate limiting, and
# emails sent synchronously in-request. Nothing else about the app changes
# either way — this is a config flag, not a code path you need to maintain.
#
# Set this once you scale beyond a single process — i.e. WEB_CONCURRENCY > 1,
# or multiple instances behind a load balancer. Without it in that setup,
# rate limits and the cache are per-process instead of shared across
# instances, which defeats their purpose (e.g. an attacker gets N request
# budgets instead of 1). When set, also run `npm run worker` (one or more) —
# without a worker consuming the queue, emails are enqueued but never sent.
#
# Local/dev (plain, no TLS):
# REDIS_URL=redis://127.0.0.1:6379
#
# Production: point at a managed/HA Redis (AWS ElastiCache, Redis Cloud,
# Upstash, etc.) over TLS with auth — use the `rediss://` scheme (note the
# extra "s") so credentials and cached data aren't sent in the clear:
# REDIS_URL=rediss://default:<password>@<host>:<port>

# Rate limiting (per IP per minute)
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=1000
# RATE_LIMIT_DISABLED=1

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/virtual-events

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# SMTP (optional — leave unset to use an auto-generated Ethereal test account)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# EMAIL_FROM="Virtual Events <no-reply@example.com>"
