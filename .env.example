# Server
PORT=3000

# Number of clustered API processes (1 = no clustering)
WEB_CONCURRENCY=1

# Redis (optional — enables the read cache, shared rate limiting, and the
# durable email queue; without it the app falls back to in-process behavior)
# REDIS_URL=redis://127.0.0.1:6379

# Rate limiting (per IP per minute)
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=1000
# RATE_LIMIT_DISABLED=1

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/virtual-events

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# SMTP (optional — leave unset to use an auto-generated Ethereal test account)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=secret
# EMAIL_FROM="Virtual Events <no-reply@example.com>"
